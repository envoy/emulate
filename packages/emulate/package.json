{
  "name": "@envoy/emulate",
  "version": "0.11.0",
  "description": "Local drop-in replacement services for CI and no-network sandboxes",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/api.js",
      "types": "./dist/api.d.ts"
    },
    "./cli": {
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/api.js",
  "types": "./dist/api.d.ts",
  "homepage": "https://emulate.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/envoy/emulate.git",
    "directory": "packages/emulate"
  },
  "bugs": {
    "url": "https://github.com/envoy/emulate/issues"
  },
  "keywords": [
    "emulator",
    "mock",
    "api",
    "vercel",
    "github",
    "google",
    "oauth",
    "testing",
    "ci",
    "local-development"
  ],
  "files": [
    "dist"
  ],
  "bin": {
    "emulate": "./dist/index.js"
  },
  "scripts": {
    "prepack": "cp ../../README.md .",
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo",
    "type-check": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "commander": "^14",
    "picocolors": "^1.1.1",
    "yaml": "^2"
  },
  "devDependencies": {
    "@envoy/emulators-core": "workspace:*",
    "@envoy/emulators-github": "workspace:*",
    "@envoy/emulators-apple": "workspace:*",
    "@envoy/emulators-microsoft": "workspace:*",
    "@envoy/emulators-okta": "workspace:*",
    "@envoy/emulators-aws": "workspace:*",
    "@envoy/emulators-google": "workspace:*",
    "@envoy/emulators-mongoatlas": "workspace:*",
    "@envoy/emulators-slack": "workspace:*",
    "@envoy/emulators-vercel": "workspace:*",
    "@envoy/emulators-resend": "workspace:*",
    "@envoy/emulators-stripe": "workspace:*",
    "@envoy/emulators-clerk": "workspace:*",
    "@envoy/emulators-linear": "workspace:*",
    "@envoy/emulators-twilio": "workspace:*",
    "tsup": "^8",
    "typescript": "^5.7"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
